{%- liquid
  assign color_inherit = false
  if section.settings.color_scheme == section.settings.section_color_scheme
    assign color_inherit = true
  endif

  assign sidebar = section.blocks | where: 'type', 'sidebar' | first
  assign name_block = section.blocks | where: 'type', 'name' | first
  assign email_block = section.blocks | where: 'type', 'email' | first

  assign form_id = 'ContactForm-' | append: section.id
  assign phone_field_index = 1
  
-%}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{%- if sidebar -%}
  {{ 'component-help-sidebar.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<div
  class="contact-form{% if color_inherit %} color-inherit{% endif %} section section--padding page-width page-width--{{ section.settings.container }} color-{{ section.settings.section_color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="contact-form__wrapper flex flex-col md:flex-row{% if sidebar != blank %} help-sidebar__wrapper help-sidebar--{{ sidebar.settings.position }}{% endif %}">
    <div class="contact-form__form flex-1">
      {%- if section.settings.heading != blank -%}
        <h2 class="contact__title inline-richtext {{ section.settings.heading_size }} text-center">
          <motion-element data-motion="fade-up" class="block">
            {% render 'highlight-text',
              hl_text: section.settings.heading,
              hl_style: section.settings.highlight_style,
              hl_font_style: section.settings.highlight_font_style,
              hl_style_color: section.settings.highlight_style_color,
              hl_text_color: section.settings.highlight_text_color
            %}
          </motion-element>
        </h2>
      {%- else -%}
        <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
      {%- endif -%}
      {%- form 'contact', id: form_id, class: 'w-full' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-status-list" role="status">
            <h3 class="form-message alert alert--success h6 blocks-radius" tabindex="-1" autofocus>
              {% render 'icon-success', size: 'small' %}
              {{ 'templates.contact.form.post_success' | t }}
            </h3>
          </div>
        {%- elsif form.errors -%}
          <div class="form-error alert alert--error blocks-radius">
            <h3 class="form-message form-message--error h6 m-0" role="alert" tabindex="-1" autofocus>
              {% render 'icon-error', size: 'small' %}
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>

            <ul role="list">
                {%- if name_block and form.errors contains 'name' -%}
                  <li>
                    <a href="#ContactForm-name-{{ name_block.id }}" class="reversed-link">
                      {{ form.errors.translated_fields.name | capitalize }}
                      {{ form.errors.messages.name }}
                    </a>
                  </li>
                {%- endif -%}
                {%- if email_block and form.errors contains 'email' -%}
                  <li>
                    <a href="#ContactForm-email-{{ email_block.id }}" class="reversed-link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="contact__fields f-grid f-grid-1-cols md:f-grid-2-cols">
            {%- comment -%} Name and Email are now rendered as blocks. Add a `name` or `email` block to show them. {%- endcomment -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'custom_field' -%}
              {%- liquid
                assign field_name_default = 'Custom field ' | append: forloop.index
                assign field_name = block.settings.heading | default: field_name_default
              -%}
              {%- if block.settings.field_type == 'phone' -%}
                {%- liquid
                  assign placeholder = 'templates.contact.form.phone' | t
                  if block.settings.placeholder != blank
                    assign placeholder = block.settings.placeholder
                  endif

                  if phone_field_index > 1
                    continue
                  endif
                -%}
                <div
                  class="form-field form-field--{{ block.settings.field_type }}{% if block.settings.full_width %} form-field--full{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.heading != blank -%}
                    <label class="form-label" for="ContactForm-{{ block.settings.field_type }}-{{ block.id }}">
                      {{- block.settings.heading -}}
                      {% if block.settings.required %}
                        <span aria-hidden="true">*</span>
                      {% endif %}
                    </label>
                  {%- endif -%}
                  <input
                    type="tel"
                    id="ContactForm-{{ block.settings.field_type }}-{{ block.id }}"
                    class="form-control"
                    autocomplete="tel"
                    name="contact[{{ 'templates.contact.form.phone' | t }}]"
                    pattern="[0-9\-]*"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    placeholder="{{ placeholder }}"
                    {% if block.settings.required %}
                      aria-invalid="true"
                      required
                    {% endif %}
                  >
                </div>
                {% assign phone_field_index = phone_field_index | plus: 1 %}
              {%- elsif block.settings.field_type == 'text' -%}
                <div
                  class="form-field form-field--{{ block.settings.field_type }}{% if block.settings.full_width %} form-field--full{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.heading != blank -%}
                    <label class="form-label" for="ContactForm-{{ block.settings.field_type }}-{{ block.id }}">
                      {{- block.settings.heading -}}
                      {% if block.settings.required %}
                        <span aria-hidden="true">*</span>
                      {% endif %}
                    </label>
                  {%- endif -%}
                  <input
                    type="text"
                    id="ContactForm-{{ block.settings.field_type }}-{{ block.id }}"
                    class="form-control"
                    name="contact[{{- field_name -}}]"
                    value=""
                    {% if block.settings.placeholder != blank %}
                      placeholder="{{ block.settings.placeholder }}"
                    {% endif %}
                    {% if block.settings.required %}
                      aria-invalid="true"
                      required
                    {% endif %}
                  >
                </div>
              {%- elsif block.settings.field_type == 'textarea' -%}
                <div
                  class="form-field form-field--{{ block.settings.field_type }}{% if block.settings.full_width %} form-field--full{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.heading != blank -%}
                    <label class="form-label" for="ContactForm-{{ block.settings.field_type }}-{{ block.id }}">
                      {{- block.settings.heading -}}
                      {% if block.settings.required %}
                        <span aria-hidden="true">*</span>
                      {% endif %}
                    </label>
                  {%- endif -%}
                  <textarea
                    rows="5"
                    id="ContactForm-{{ block.settings.field_type }}-{{ block.id }}"
                    class="form-control form-control--textarea"
                    name="contact[{{- field_name -}}]"
                    {% if block.settings.placeholder != blank %}
                      placeholder="{{ block.settings.placeholder }}"
                    {% endif %}
                    {% if block.settings.required %}
                      aria-invalid="true"
                      required
                    {% endif %}
                  >
                      {{- form[field_name] -}}
                    </textarea>
                </div>
              {%- elsif block.settings.field_type == 'select' -%}
                {% assign options = block.settings.select_options | split: ',' %}
                <div
                  class="form-field form-field--{{ block.settings.field_type }}{% if block.settings.full_width %} form-field--full{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.heading != blank -%}
                    <label class="form-label" for="ContactForm-{{ block.settings.field_type }}-{{ block.id }}">
                      {{- block.settings.heading -}}
                      {% if block.settings.required %}
                        <span aria-hidden="true">*</span>
                      {% endif %}
                    </label>
                  {%- endif -%}
                  <div class="select">
                    <select
                      id="ContactForm-{{ block.settings.field_type }}-{{ block.id }}"
                      name="contact[{{- field_name -}}]"
                      class="form-control form-control--select"
                      {% if block.settings.required %}
                        aria-invalid="true"
                        required
                      {% endif %}
                    >
                      {%- if block.settings.placeholder != blank -%}
                        <option value="">{{ block.settings.placeholder }}</option>
                      {%- endif -%}
                      {%- for option in options -%}
                        <option value="{{ option }}" label="{{ option }}">{{ option }}</option>
                      {%- endfor -%}
                    </select>
                    {%- render 'icon-caret-down', size: '2xs' -%}
                  </div>
                </div>
              {%- elsif block.settings.field_type == 'checkbox' -%}
                <div
                  class="form-field form-field--{{ block.type }}{% if block.settings.full_width %} form-field--full{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="flex items-center gap-x-3">
                    <input
                      type="hidden"
                      name="contact[{{- field_name -}}]"
                      value="{{ block.settings.checkbox_uncheck_value }}"
                    >
                    <input
                      type="checkbox"
                      name="contact[{{- field_name -}}]"
                      id="ContactForm-{{ block.settings.field_type }}-{{ block.id }}"
                      value="{{ block.settings.checkbox_checked_value }}"
                      {% if block.settings.required %}
                        aria-invalid="true"
                        required
                      {% endif %}
                    >
                    {%- if block.settings.heading != blank -%}
                      <label class="flex-1" for="ContactForm-{{ block.settings.field_type }}-{{ block.id }}">
                        {{- block.settings.heading -}}
                        {% if block.settings.required %}
                          <span aria-hidden="true">*</span>
                        {% endif %}
                      </label>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- elsif block.type == 'name' -%}
              <div class="form-field form-field--name" {{ block.shopify_attributes }}>
                <label class="form-label" for="ContactForm-name-{{ block.id }}">
                  {{- 'templates.contact.form.name' | t -}}
                  <span aria-hidden="true">*</span>
                </label>
                <input
                  class="form-control"
                  autocomplete="name"
                  type="text"
                  id="ContactForm-name-{{ block.id }}"
                  name="contact[{{ 'templates.contact.form.name' | t }}]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.name' | t }}"
                  {% if block.settings.required %} required {% endif %}
                >
              </div>
            {%- elsif block.type == 'email' -%}
              <div class="form-field form-field--email" {{ block.shopify_attributes }}>
                <label class="form-label" for="ContactForm-email-{{ block.id }}">
                  {{- 'templates.contact.form.email' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                <input
                  autocomplete="email"
                  type="email"
                  id="ContactForm-email-{{ block.id }}"
                  class="form-control"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  {% if block.settings.required %} aria-invalid="true" required {% endif %}
                  {% if form.errors contains 'email' %}
                    aria-describedby="ContactForm-email-error-{{ block.id }}"
                  {% endif %}
                  placeholder="{{ 'templates.contact.form.email' | t }}"
                >
                {%- if form.errors contains 'email' -%}
                  <span
                    class="form-message form-message--small form-message--error"
                    id="ContactForm-email-error-{{ block.id }}"
                  >
                    {% render 'icon-error', size: 'small' %}
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                {%- endif -%}
              </div>
            {%- elsif block.type == 'dropdown' -%}
              {%- liquid
                assign field_handle = block.settings.title | handleize
                assign field_options = block.settings.options | newline_to_br | strip_newlines | split: '<br />'
                assign native_name = 'contact[' | append: field_handle | append: ']'
                assign selected_value = form[field_handle] | default: field_options.first
              -%}
              <div class="form-field form-field--select{% if block.settings.full_width %} form-field--full{% endif %}" {{ block.shopify_attributes }}>
                <label class="form-label" for="ContactForm-dropdown-{{ block.id }}">{{- block.settings.title -}}</label>
                <div class="select">
                  <select class="form-control" name="{{ native_name }}" id="ContactForm-dropdown-{{ block.id }}">
                    {%- for option in field_options -%}
                      <option value="{{ option | escape }}"{% if option == selected_value %} selected{% endif %}>{{ option }}</option>
                    {%- endfor -%}
                  </select>
                  {%- render 'icon-caret-down', size: '2xs' -%}
                </div>
              </div>
            {%- elsif block.type == 'text' -%}
              <div class="form-field form-field--full form-field--body" {{ block.shopify_attributes }}>
                <div class="w-full rte">{{ block.settings.text }}</div>
              </div>
            {%- elsif block.type == 'checkbox' -%}
              {% if block.settings.title != blank %}
                {%- assign title_handle = block.settings.title | handle -%}
                <div class="form-field" {{ block.shopify_attributes }}>
                  <input type="hidden" name="contact[{{ title_handle }}]" value="{{ block.settings.value_no | escape }}" />
                  <input type="checkbox" id="contact_{{ title_handle }}" name="contact[{{ title_handle }}]" value="{{ block.settings.value_yes | escape }}" {% if block.settings.required %} required{% endif %} {% if form[title_handle] == block.settings.value_yes %} checked{% endif %} />
                  <label for="contact_{{ title_handle }}" class="flex-1">{{ block.settings.title | escape }}{% if block.settings.required %} *{% endif %}</label>
                </div>
              {% endif %}
            {%- endif -%}
          {%- endfor -%}
          <div class="form-field form-field--full form-field--body">
            <label class="form-label" for="ContactForm-body-{{ section.id }}">
              {{- 'templates.contact.form.comment' | t -}}
            </label>
            <textarea
              rows="5"
              id="ContactForm-body-{{ section.id }}"
              class="form-control form-control--textarea"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="{{ 'templates.contact.form.comment' | t }}"
            >
              {{- form.body -}}
            </textarea>
          </div>
          <div class="contact__button form-footer form-field--full">
            <button type="submit" class="btn btn--primary">
              <span class="btn__text">{{ 'templates.contact.form.send' | t }}</span>
            </button>
          </div>
        </div>
      {%- endform -%}
    </div>
    {%- if sidebar != blank -%}
      {% render 'help-sidebar', sidebar: sidebar %}
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.general.name"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        },
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.container.label"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:general.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.section_header.content"
    },
    
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Contact form",
      "label": "t:general.heading.label",
      "info": "t:general.heading.info"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "t:general.highlight_text.highlight_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:general.highlight_text.highlight_style.options.option__1.label"
        },
        {
          "value": "hand_drawn_circle",
          "label": "t:general.highlight_text.highlight_style.options.option__2.label"
        },
        {
          "value": "thick_underline",
          "label": "t:general.highlight_text.highlight_style.options.option__3.label"
        },
        {
          "value": "wave_underline",
          "label": "t:general.highlight_text.highlight_style.options.option__4.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "highlight_font_style",
      "label": "t:general.highlight_text.highlight_font_style.label",
      "options": [
        {
          "value": "italic",
          "label": "t:general.highlight_text.highlight_font_style.options.option__1.label"
        },
        {
          "value": "normal",
          "label": "t:general.highlight_text.highlight_font_style.options.option__2.label"
        }
      ]
    },
    {
      "type": "color",
      "id": "highlight_style_color",
      "label": "t:general.highlight_text.highlight_style_color.label"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "t:general.highlight_text.highlight_text_color.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:general.text_size.heading.label",
      "default": "h1",
      "options": [
        {
          "value": "h5",
          "label": "t:general.text_size.options__h5.label"
        },
        {
          "value": "h4",
          "label": "t:general.text_size.options__h4.label"
        },
        {
          "value": "h3",
          "label": "t:general.text_size.options__h3.label"
        },
        {
          "value": "h2",
          "label": "t:general.text_size.options__h2.label"
        },
        {
          "value": "h1",
          "label": "t:general.text_size.options__h1.label"
        },
        {
          "value": "hd2",
          "label": "t:general.text_size.options__hd2.label"
        },
        {
          "value": "hd1",
          "label": "t:general.text_size.options__hd1.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.top.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.bottom.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:general.divider.section_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:general.divider.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.divider.width.label"
    }
  ],
  "blocks": [
    {
      "type": "custom_field",
      "name": "t:sections.contact-form.blocks.custom_field.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.contact-form.blocks.custom_field.paragraph"
        },
        {
          "type": "select",
          "id": "field_type",
          "label": "t:sections.contact-form.blocks.custom_field.settings.field_type.label",
          "default": "text",
          "info": "t:sections.contact-form.blocks.custom_field.settings.field_type.info",
          "options": [
            {
              "value": "text",
              "label": "t:general.form.text.name"
            },
            {
              "value": "textarea",
              "label": "t:general.form.textarea.name"
            },
            {
              "value": "phone",
              "label": "t:general.form.phone.name"
            },
            {
              "value": "select",
              "label": "t:general.form.select.name"
            },
            {
              "value": "checkbox",
              "label": "t:general.form.checkbox.name"
            },
            {
              "value": "radio",
              "label": "t:general.form.radio.name"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.form.label.label"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "t:general.form.placeholder.label"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:general.form.required.label",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "t:sections.contact-form.blocks.custom_field.settings.full_width.label",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.contact-form.blocks.custom_field.select_header.content",
          "info": "t:sections.contact-form.blocks.custom_field.select_header.info"
        },
        {
          "type": "text",
          "id": "select_options",
          "label": "t:sections.contact-form.blocks.custom_field.settings.select_options.label",
          "info": "t:sections.contact-form.blocks.custom_field.settings.select_options.info"
        },
        {
          "type": "header",
          "content": "t:sections.contact-form.blocks.custom_field.checkbox_header.content",
          "info": "t:sections.contact-form.blocks.custom_field.checkbox_header.info"
        },
        {
          "type": "text",
          "id": "checkbox_checked_value",
          "label": "t:sections.contact-form.blocks.custom_field.settings.checkbox_checked_value.label",
          "default": "Yes"
        },
        {
          "type": "text",
          "id": "checkbox_uncheck_value",
          "label": "t:sections.contact-form.blocks.custom_field.settings.checkbox_uncheck_value.label",
          "default": "No"
        },
        {
          "type": "header",
          "content": "t:sections.contact-form.blocks.custom_field.radio_header.content",
          "info": "t:sections.contact-form.blocks.custom_field.radio_header.info"
        },
        {
          "type": "text",
          "id": "radio_options",
          "label": "t:sections.contact-form.blocks.custom_field.settings.radio_options.label",
          "info": "t:sections.contact-form.blocks.custom_field.settings.radio_options.info"
        }
      ]
    },
    {
      "type": "name",
      "name": "Name",
      "settings": [
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        }
      ]
    },
    {
      "type": "email",
      "name": "Email",
      "settings": [
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        }
      ]
    },
      {
        "type": "dropdown",
        "name": "Dropdown",
        "settings": [
          {
            "type": "paragraph",
            "content": "Dropdowns require a label, and that label may only be used once in the form."
          },
          {
            "type": "text",
            "id": "title",
            "label": "Label",
            "default": "Dropdown"
          },
          {
            "type": "textarea",
            "id": "options",
            "label": "Options",
            "info": "One option per line.",
            "default": "Option 1\nOption 2\nOption 3"
          },
          {
            "type": "checkbox",
            "id": "full_width",
            "label": "Full width",
            "default": false
          }
        ]
      },
      {
        "type": "text",
        "name": "Text",
        "settings": [
          {
            "type": "richtext",
            "id": "text",
